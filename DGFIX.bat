@echo off
setlocal EnableExtensions
cd /d "%~dp0"

rem ============================================================
rem DGFIX.bat  -  BRAX FIX TOOL
rem Decodes an embedded Base64 PowerShell script to DGFIX.ps1
rem (UTF-8 w/ BOM, so the ASCII art renders), then runs it.
rem Menu:  [1] fix (disable)   [2] exit   [3] undo (re-enable)
rem Self-elevates via UAC, runs Microsoft's DG Readiness Tool,
rem then (after Enter) offers to restart the PC.
rem ============================================================

chcp 65001 >nul 2>&1
set "PS1=%~dp0DGFIX.ps1"
set "B64=%TEMP%\DGFIX_%RANDOM%%RANDOM%.b64"

